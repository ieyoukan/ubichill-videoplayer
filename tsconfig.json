{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "WebWorker"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "jsxImportSource": "ubichill"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "frontend"]
}
